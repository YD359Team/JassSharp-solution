{
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:MyMap}",
      "{",
      "    $0",
      "}"
    ],
    "description": "Создать namespace"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}",
      "{",
      "    $0",
      "}"
    ],
    "description": "Создать класс"
  },
  "Function": {
    "prefix": "function",
    "body": [
      "${1:void} ${2:Name}(${3})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Объявить функцию или метод"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Условный блок"
  },
  "IfElse": {
    "prefix": "ife",
    "body": [
      "if (${1:condition})",
      "{",
      "    $2",
      "}",
      "else",
      "{",
      "    $0",
      "}"
    ],
    "description": "Условие if / else"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while (${1:condition})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Цикл while"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:count}; ${1:i} = ${1:i} + 1)",
      "{",
      "    $0",
      "}"
    ],
    "description": "Цикл for"
  },
  "OnInit": {
    "prefix": "oninit",
    "body": [
      "void OnInit()",
      "{",
      "    $0",
      "}"
    ],
    "description": "Точка входа OnInit"
  },
  "Trigger": {
    "prefix": "trigger",
    "body": [
      "trigger ${1:t} = new trigger();",
      "${1:t}.RegisterAnyUnitEvent(${2:EVENT_PLAYER_UNIT_SPELL_EFFECT});",
      "${1:t}.AddAction(${3:OnAction});"
    ],
    "description": "Создать триггер и зарегистрировать обработчик"
  },
  "DebugMessage": {
    "prefix": "debug",
    "body": [
      "BJDebugMsg(${1:\"message\"});$0"
    ],
    "description": "Вывести отладочное сообщение"
  }
}
