{
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:MyMap}",
      "{",
      "    $0",
      "}"
    ],
    "description": "Создать пространство имён"
  },
  "WarcraftNamespace": {
    "prefix": [
      "wc3namespace",
      "namespacewc3"
    ],
    "body": [
      "namespace ${1:MyMap}",
      "{",
      "    using Warcraft3;",
      "",
      "    $0",
      "}"
    ],
    "description": "Пространство имён с подключённым API Warcraft III"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "public class ${1:MyClass}",
      "{",
      "    $0",
      "}"
    ],
    "description": "Объявить класс"
  },
  "ClassWithConstructor": {
    "prefix": [
      "classctor",
      "classfull"
    ],
    "body": [
      "public class ${1:MyClass}",
      "{",
      "    public ${1:MyClass}(${2})",
      "    {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Объявить класс с конструктором"
  },
  "Constructor": {
    "prefix": [
      "ctor",
      "constructor"
    ],
    "body": [
      "public ${1:MyClass}(${2})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Конструктор класса"
  },
  "Destructor": {
    "prefix": [
      "dtor",
      "destructor"
    ],
    "body": [
      "~${1:MyClass}()",
      "{",
      "    $0",
      "}"
    ],
    "description": "Ручной деструктор, вызываемый через Dispose()"
  },
  "Method": {
    "prefix": [
      "method",
      "func",
      "function"
    ],
    "body": [
      "public ${1:void} ${2:MethodName}(${3})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Объявить метод экземпляра"
  },
  "StaticMethod": {
    "prefix": [
      "static",
      "staticmethod"
    ],
    "body": [
      "public static ${1:void} ${2:MethodName}(${3})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Объявить статический метод"
  },
  "Function": {
    "prefix": [
      "function",
      "fn"
    ],
    "body": [
      "${1:void} ${2:FunctionName}(${3})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Объявить функцию в namespace"
  },
  "WarcraftEntryPoint": {
    "prefix": [
      "main",
      "entry",
      "oninit"
    ],
    "body": [
      "void OnInit()",
      "{",
      "    $0",
      "}"
    ],
    "description": "Точка входа пользовательской логики Warcraft III. Компилятор сам генерирует config() и main()."
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "public enum ${1:MyEnum}",
      "{",
      "    ${2:First},",
      "    ${3:Second}",
      "}"
    ],
    "description": "Объявить перечисление"
  },
  "UsingWarcraft3": {
    "prefix": [
      "usingwc3",
      "warcraft3"
    ],
    "body": [
      "using Warcraft3;"
    ],
    "description": "Подключить модуль API Warcraft III"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Условный блок"
  },
  "IfElse": {
    "prefix": [
      "ife",
      "ifelse"
    ],
    "body": [
      "if (${1:condition})",
      "{",
      "    $2",
      "}",
      "else",
      "{",
      "    $0",
      "}"
    ],
    "description": "Условие if / else"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while (${1:condition})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Цикл while"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:count}; ${1:i} = ${1:i} + 1)",
      "{",
      "    $0",
      "}"
    ],
    "description": "Индексный цикл"
  },
  "Foreach": {
    "prefix": [
      "foreach",
      "forEach"
    ],
    "body": [
      "foreach (var ${1:item} in ${2:items})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Обход массива или Warcraft III group"
  },
  "JaggedArray": {
    "prefix": [
      "jagged",
      "array2d"
    ],
    "body": [
      "${1:int}[][] ${2:matrix} = new ${1:int}[][];",
      "$0"
    ],
    "description": "Объявить массив массивов"
  },
  "Trigger": {
    "prefix": "trigger",
    "body": [
      "trigger ${1:t} = new trigger();",
      "${1:t}.RegisterAnyUnitEvent(${2:EVENT_PLAYER_UNIT_SPELL_EFFECT});",
      "${1:t}.AddAction(${3:OnAction});$0"
    ],
    "description": "Создать Warcraft III trigger и зарегистрировать обработчик"
  },
  "TriggerAction": {
    "prefix": [
      "triggeraction",
      "action"
    ],
    "body": [
      "void ${1:OnAction}()",
      "{",
      "    unit ${2:caster} = GetTriggerUnit();",
      "    $0",
      "}"
    ],
    "description": "Обработчик действия Warcraft III trigger"
  },
  "DebugMessage": {
    "prefix": [
      "debug",
      "print"
    ],
    "body": [
      "Print(${1:\"message\"});$0"
    ],
    "description": "Вывести отладочное сообщение"
  },
  "TimerOneShot": {
    "prefix": [
      "timer",
      "timeronce",
      "timerstart"
    ],
    "body": [
      "timer ${1:taskTimer} = CreateTimer();",
      "TimerStart(${1:taskTimer}, ${2:1.0}, false, ${3:OnTimerExpired});",
      "$0"
    ],
    "description": "Создать одноразовый Warcraft III timer и запустить callback. Требуется using Warcraft3;"
  },
  "TimerPeriodic": {
    "prefix": [
      "timerperiodic",
      "periodictimer"
    ],
    "body": [
      "timer ${1:periodicTimer} = CreateTimer();",
      "TimerStart(${1:periodicTimer}, ${2:1.0}, true, ${3:OnPeriodicTimer});",
      "$0"
    ],
    "description": "Создать периодический Warcraft III timer. Требуется using Warcraft3;"
  },
  "TimerCallback": {
    "prefix": [
      "timercallback",
      "ontimer"
    ],
    "body": [
      "void ${1:OnTimerExpired}()",
      "{",
      "    timer expired = GetExpiredTimer();",
      "    $0",
      "    DestroyTimer(expired);",
      "}"
    ],
    "description": "Callback таймера; GetExpiredTimer возвращает сработавший timer. Требуется using Warcraft3;"
  },
  "GroupEnumeration": {
    "prefix": [
      "groupenum",
      "enumunitsrange"
    ],
    "body": [
      "group ${1:units} = CreateGroup();",
      "GroupEnumUnitsInRange(${1:units}, ${2:x}, ${3:y}, ${4:radius}, null);",
      "ForGroup(${1:units}, ${5:OnEnumUnit});",
      "DestroyGroup(${1:units});",
      "$0"
    ],
    "description": "Перечислить юнитов в радиусе через group и ForGroup. Требуется using Warcraft3;"
  },
  "GroupCallback": {
    "prefix": [
      "groupcallback",
      "onenumunit"
    ],
    "body": [
      "void ${1:OnEnumUnit}()",
      "{",
      "    unit ${2:enumUnit} = GetEnumUnit();",
      "    $0",
      "}"
    ],
    "description": "Callback ForGroup; текущий юнит доступен через GetEnumUnit(). Требуется using Warcraft3;"
  },
  "CreateUnit": {
    "prefix": [
      "createunit",
      "spawnunit"
    ],
    "body": [
      "unit ${1:createdUnit} = CreateUnit(Player(${2:0}), '${3:hfoo}', ${4:0.0}, ${5:0.0}, ${6:270.0});",
      "$0"
    ],
    "description": "Создать юнита по rawcode на координатах. Требуется using Warcraft3;"
  },
  "SpellEffectTrigger": {
    "prefix": [
      "spelltrigger",
      "spellcast",
      "spellinit"
    ],
    "body": [
      "trigger ${1:spellTrigger} = CreateTrigger();",
      "TriggerRegisterPlayerUnitEvent(${1:spellTrigger}, Player(${2:0}), EVENT_PLAYER_UNIT_SPELL_EFFECT, null);",
      "TriggerAddAction(${1:spellTrigger}, ${3:OnSpellEffect});",
      "$0"
    ],
    "description": "Зарегистрировать callback на событие применения способности игроком. Требуется using Warcraft3;"
  },
  "SpellEffectCallback": {
    "prefix": [
      "spellcallback",
      "onspelleffect"
    ],
    "body": [
      "void ${1:OnSpellEffect}()",
      "{",
      "    unit caster = GetTriggerUnit();",
      "    int abilityId = GetSpellAbilityId();",
      "    float targetX = GetSpellTargetX();",
      "    float targetY = GetSpellTargetY();",
      "    $0",
      "}"
    ],
    "description": "Обработчик SPELL_EFFECT с caster, rawcode способности и координатами цели. Требуется using Warcraft3;"
  },
  "CreateEffect": {
    "prefix": [
      "effectpoint",
      "specialeffect"
    ],
    "body": [
      "effect ${1:spellEffect} = AddSpecialEffect(${2:\"Abilities\\\\Spells\\\\Other\\\\Fireball\\\\Fireball.mdl\"}, ${3:x}, ${4:y});",
      "$0"
    ],
    "description": "Создать special effect в точке. Освобождение effect handle выполняйте через DestroyEffect, когда эффект больше не нужен. Требуется using Warcraft3;"
  },
  "AttachEffect": {
    "prefix": [
      "effectattach",
      "attachsfx"
    ],
    "body": [
      "effect ${1:attachedEffect} = AddSpecialEffectTarget(${2:\"Abilities\\\\Weapons\\\\AvengerMissile\\\\AvengerMissile.mdl\"}, ${3:targetUnit}, ${4:\"origin\"});",
      "$0"
    ],
    "description": "Прикрепить special effect к widget target. Требуется using Warcraft3;"
  },
  "DamageTarget": {
    "prefix": [
      "unitdamage",
      "damagetarget"
    ],
    "body": [
      "UnitDamageTarget(${1:sourceUnit}, ${2:targetUnit}, ${3:100.0}, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS);",
      "$0"
    ],
    "description": "Нанести урон цели через UnitDamageTarget. Требуется using Warcraft3;"
  }
}
