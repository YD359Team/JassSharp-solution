{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:namespace|class|if|else|while|for|(?:[A-Za-z_]\\w*\\s+)?[A-Za-z_]\\w*\\s*\\([^)]*\\))\\s*$",
      "action": {
        "indentAction": 2
      }
    },
    {
      "beforeText": "^\\s*\\{\\s*$",
      "afterText": "^\\s*\\}\\s*$",
      "action": {
        "indentAction": 0,
        "removeText": 1
      }
    }
  ],
  "wordPattern": "(-?\\d*\\.\\d+)|([A-Za-z_$][A-Za-z0-9_$]*)"
}
