{
  "name": "jasssharp",
  "displayName": "JASS#",
  "description": "Подсветка и сборка JASS# (.w3js) в Lua",
  "version": "0.1.0",
  "publisher": "jasssharp",
  "repository": {
    "type": "git",
    "url": "https://github.com/YD359Team/JassSharp-solution"
  },
  "license": "MIT",
  "icon": "image.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:jasssharp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jasssharp",
        "aliases": [
          "JASS#",
          "jasssharp"
        ],
        "extensions": [
          ".w3js"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./image.png",
          "dark": "./image.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "jasssharp",
        "scopeName": "source.jasssharp",
        "path": "./syntaxes/jasssharp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jasssharp",
        "path": "./snippets/jasssharp.json"
      }
    ],
    "configuration": {
      "title": "JASS#",
      "properties": {
        "jasssharp.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Путь к jasssharp (exe или dll). Пусто — ищется в PATH."
        },
        "jasssharp.defaultTarget": {
          "type": "string",
          "enum": [
            "lua"
          ],
          "default": "lua",
          "description": "Цель сборки. В настоящее время поддерживается только Lua."
        },
        "jasssharp.gamePath": {
          "type": "string",
          "default": "",
          "description": "Путь к Warcraft III.exe для команды Run Map."
        },
        "jasssharp.editorPath": {
          "type": "string",
          "default": "",
          "description": "Путь к World Editor.exe. Пусто — ищется рядом с игрой."
        },
        "jasssharp.mpqToolPath": {
          "type": "string",
          "default": "",
          "description": "Путь к mpqtool.exe (или другому упаковщику) для команды Pack Map."
        },
        "jasssharp.projectFile": {
          "type": "string",
          "default": "jasssharp.json",
          "description": "Имя файла проекта карты."
        }
      }
    },
    "commands": [
      {
        "command": "jasssharp.build",
        "title": "JASS#: Build",
        "icon": "$(tools)"
      },
      {
        "command": "jasssharp.buildLua",
        "title": "JASS#: Build Lua"
      },
      {
        "command": "jasssharp.buildMap",
        "title": "JASS#: Build Map",
        "icon": "$(package)"
      },
      {
        "command": "jasssharp.runMap",
        "title": "JASS#: Run Map",
        "icon": "$(play)"
      },
      {
        "command": "jasssharp.openEditor",
        "title": "JASS#: Open in World Editor",
        "icon": "$(edit)"
      },
      {
        "command": "jasssharp.packMap",
        "title": "JASS#: Pack Map",
        "icon": "$(archive)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jasssharp.build",
          "when": "editorLangId == jasssharp",
          "group": "navigation"
        },
        {
          "command": "jasssharp.runMap",
          "when": "editorLangId == jasssharp && jasssharp.mode != headless",
          "group": "navigation"
        },
        {
          "command": "jasssharp.openEditor",
          "when": "editorLangId == jasssharp && jasssharp.mode != headless",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "jasssharp.runMap",
          "when": "editorLangId == jasssharp && jasssharp.mode != headless",
          "group": "navigation@1"
        },
        {
          "command": "jasssharp.buildMap",
          "when": "editorLangId == jasssharp && jasssharp.mode != headless",
          "group": "navigation@2"
        },
        {
          "command": "jasssharp.openEditor",
          "when": "editorLangId == jasssharp && jasssharp.mode != headless",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
