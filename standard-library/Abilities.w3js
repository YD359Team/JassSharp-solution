namespace Abilities
{
    using Warcraft3;
    using Math;

    // A non-owning view of one ability identified by rawcode on a unit.
    public class UnitAbility
    {
        private unit _owner;
        private int _rawcode;

        public UnitAbility(unit owner, int rawcode)
        {
            _owner = owner;
            _rawcode = rawcode;
        }

        public bool IsPresent()
        {
            return GetUnitAbilityLevel(_owner, _rawcode) > 0;
        }

        public bool Add()
        {
            return UnitAddAbility(_owner, _rawcode);
        }

        public bool Remove()
        {
            return UnitRemoveAbility(_owner, _rawcode);
        }

        public int Level()
        {
            return GetUnitAbilityLevel(_owner, _rawcode);
        }

        public int SetLevel(int level)
        {
            if (level < 0) { level = 0; }
            return SetUnitAbilityLevel(_owner, _rawcode, level);
        }

        public int IncreaseLevel()
        {
            return IncUnitAbilityLevel(_owner, _rawcode);
        }

        public int DecreaseLevel()
        {
            return DecUnitAbilityLevel(_owner, _rawcode);
        }

        public bool SetPermanent(bool permanent)
        {
            return UnitMakeAbilityPermanent(_owner, permanent, _rawcode);
        }

        // hideUI controls whether the disabled ability is also hidden from the command UI.
        public void SetEnabled(bool enabled, bool hideUI)
        {
            BlzUnitDisableAbility(_owner, _rawcode, !enabled, hideUI);
        }

        public float Cooldown(int level)
        {
            if (level < 0) { level = 0; }
            return BlzGetUnitAbilityCooldown(_owner, _rawcode, level);
        }

        public float RemainingCooldown()
        {
            return BlzGetUnitAbilityCooldownRemaining(_owner, _rawcode);
        }

        public void StartCooldown(float seconds)
        {
            BlzStartUnitAbilityCooldown(_owner, _rawcode, Math.Max(seconds, 0.0));
        }

        public void EndCooldown()
        {
            BlzEndUnitAbilityCooldown(_owner, _rawcode);
        }

        public int ManaCost(int level)
        {
            if (level < 0) { level = 0; }
            return BlzGetUnitAbilityManaCost(_owner, _rawcode, level);
        }

        // Ability field access is typed by Warcraft III's field handle enums.
        public bool BooleanField(abilitybooleanfield field)
        {
            return BlzGetAbilityBooleanField(Handle(), field);
        }

        public bool SetBooleanField(abilitybooleanfield field, bool value)
        {
            return BlzSetAbilityBooleanField(Handle(), field, value);
        }

        // These methods forward to the native API; field validity is the caller's responsibility.
        public int IntegerField(abilityintegerfield field)
        {
            return BlzGetAbilityIntegerField(Handle(), field);
        }

        public bool SetIntegerField(abilityintegerfield field, int value)
        {
            return BlzSetAbilityIntegerField(Handle(), field, value);
        }

        public float RealField(abilityrealfield field)
        {
            return BlzGetAbilityRealField(Handle(), field);
        }

        public bool SetRealField(abilityrealfield field, float value)
        {
            return BlzSetAbilityRealField(Handle(), field, value);
        }

        public string StringField(abilitystringfield field)
        {
            return BlzGetAbilityStringField(Handle(), field);
        }

        public bool SetStringField(abilitystringfield field, string value)
        {
            return BlzSetAbilityStringField(Handle(), field, value);
        }


        // Level fields use zero-based ability-level indices.

        public bool BooleanLevelField(abilitybooleanlevelfield field, int level)
        {
            return BlzGetAbilityBooleanLevelField(Handle(), field, level);
        }

        public bool SetBooleanLevelField(abilitybooleanlevelfield field, int level, bool value)
        {
            return BlzSetAbilityBooleanLevelField(Handle(), field, level, value);
        }

        public int IntegerLevelField(abilityintegerlevelfield field, int level)
        {
            return BlzGetAbilityIntegerLevelField(Handle(), field, level);
        }

        public bool SetIntegerLevelField(abilityintegerlevelfield field, int level, int value)
        {
            return BlzSetAbilityIntegerLevelField(Handle(), field, level, value);
        }

        public float RealLevelField(abilityreallevelfield field, int level)
        {
            return BlzGetAbilityRealLevelField(Handle(), field, level);
        }

        public bool SetRealLevelField(abilityreallevelfield field, int level, float value)
        {
            return BlzSetAbilityRealLevelField(Handle(), field, level, value);
        }

        public string StringLevelField(abilitystringlevelfield field, int level)
        {
            return BlzGetAbilityStringLevelField(Handle(), field, level);
        }

        public bool SetStringLevelField(abilitystringlevelfield field, int level, string value)
        {
            return BlzSetAbilityStringLevelField(Handle(), field, level, value);
        }

        // Level-array fields use a zero-based ability level and array index.

        public bool BooleanLevelArrayField(abilitybooleanlevelarrayfield field, int level, int index)
        {
            return BlzGetAbilityBooleanLevelArrayField(Handle(), field, level, index);
        }

        public bool SetBooleanLevelArrayField(abilitybooleanlevelarrayfield field, int level, int index, bool value)
        {
            return BlzSetAbilityBooleanLevelArrayField(Handle(), field, level, index, value);
        }

        public bool AddBooleanLevelArrayField(abilitybooleanlevelarrayfield field, int level, bool value)
        {
            return BlzAddAbilityBooleanLevelArrayField(Handle(), field, level, value);
        }

        public bool RemoveBooleanLevelArrayField(abilitybooleanlevelarrayfield field, int level, bool value)
        {
            return BlzRemoveAbilityBooleanLevelArrayField(Handle(), field, level, value);
        }

        public int IntegerLevelArrayField(abilityintegerlevelarrayfield field, int level, int index)
        {
            return BlzGetAbilityIntegerLevelArrayField(Handle(), field, level, index);
        }

        public bool SetIntegerLevelArrayField(abilityintegerlevelarrayfield field, int level, int index, int value)
        {
            return BlzSetAbilityIntegerLevelArrayField(Handle(), field, level, index, value);
        }

        public bool AddIntegerLevelArrayField(abilityintegerlevelarrayfield field, int level, int value)
        {
            return BlzAddAbilityIntegerLevelArrayField(Handle(), field, level, value);
        }

        public bool RemoveIntegerLevelArrayField(abilityintegerlevelarrayfield field, int level, int value)
        {
            return BlzRemoveAbilityIntegerLevelArrayField(Handle(), field, level, value);
        }

        public float RealLevelArrayField(abilityreallevelarrayfield field, int level, int index)
        {
            return BlzGetAbilityRealLevelArrayField(Handle(), field, level, index);
        }

        public bool SetRealLevelArrayField(abilityreallevelarrayfield field, int level, int index, float value)
        {
            return BlzSetAbilityRealLevelArrayField(Handle(), field, level, index, value);
        }

        public bool AddRealLevelArrayField(abilityreallevelarrayfield field, int level, float value)
        {
            return BlzAddAbilityRealLevelArrayField(Handle(), field, level, value);
        }

        public bool RemoveRealLevelArrayField(abilityreallevelarrayfield field, int level, float value)
        {
            return BlzRemoveAbilityRealLevelArrayField(Handle(), field, level, value);
        }

        public string StringLevelArrayField(abilitystringlevelarrayfield field, int level, int index)
        {
            return BlzGetAbilityStringLevelArrayField(Handle(), field, level, index);
        }

        public bool SetStringLevelArrayField(abilitystringlevelarrayfield field, int level, int index, string value)
        {
            return BlzSetAbilityStringLevelArrayField(Handle(), field, level, index, value);
        }

        public bool AddStringLevelArrayField(abilitystringlevelarrayfield field, int level, string value)
        {
            return BlzAddAbilityStringLevelArrayField(Handle(), field, level, value);
        }

        public bool RemoveStringLevelArrayField(abilitystringlevelarrayfield field, int level, string value)
        {
            return BlzRemoveAbilityStringLevelArrayField(Handle(), field, level, value);
        }

        // Returns the borrowed native ability handle for advanced native API calls.
        public ability Handle()
        {
            return BlzGetUnitAbility(_owner, _rawcode);
        }
    }
}
