                _disposed = true;
            }
        }
    }

    // Owns a trigger and action for one frame event subscription.
    public class FrameEventSubscription
    {
        private trigger _trigger;
        private triggeraction _action;
        private event _event;
        private bool _disposed;

        public FrameEventSubscription(framehandle frame, frameeventtype eventType, code callback)
        {
            _trigger = CreateTrigger();
            _event = BlzTriggerRegisterFrameEvent(_trigger, frame, eventType);
            _action = TriggerAddAction(_trigger, callback);
            _disposed = false;
        }

        public event Event()
        {
            if (_disposed) { return null; }
            return _event;
        }

        public bool IsDisposed()
        {
            return _disposed;
        }

        ~FrameEventSubscription()
        {
            if (!_disposed)
            {
                TriggerRemoveAction(_trigger, _action);
                DestroyTrigger(_trigger);
                _disposed = true;
            }
        }
    }

    // Frame event context is read inside the trigger action registered for that event.
    public class FrameEvents
    {
        public static framehandle CurrentFrame()
        {
            return BlzGetTriggerFrame();
        }

        public static frameeventtype CurrentEvent()
        {
            return BlzGetTriggerFrameEvent();
        }

        public static float CurrentValue()
        {
            return BlzGetTriggerFrameValue();
        }

        public static string CurrentText()
        {
            return BlzGetTriggerFrameText();
        }
    }

    // Coordinates are expressed in Warcraft III's normalized frame coordinate space.
    public class FrameCoordinates
    {
        public static float HudScale()
        {
            return BlzGetHUDScale();
        }

        public static int ClientWidth()
        {
            return BlzGetLocalClientWidth();
        }

        public static int ClientHeight()
        {
            return BlzGetLocalClientHeight();
        }

        public static float PixelToFrameX(int pixels)
        {
            return BlzPixelToFrameX(pixels);
        }

        public static float PixelToFrameY(int pixels)
        {
            return BlzPixelToFrameY(pixels);
        }

        public static int FrameToPixelX(float value)
        {
            return BlzFrameToPixelX(value);
        }

        public static int FrameToPixelY(float value)
        {
            return BlzFrameToPixelY(value);
        }
    }
}