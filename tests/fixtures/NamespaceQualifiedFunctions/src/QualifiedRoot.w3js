namespace QualifiedRoot
{
    using MathTools;

    int Verify()
    {
        return MathTools.Add(2, 3);
    }

    bool VerifyEnum()
    {
        return MathTools.Colors.Red == MathTools.Colors.Blue;
    }

    int VerifyGlobals()
    {
        MathTools.Offset = 7;
        return MathTools.BaseValue + MathTools.Offset;
    }

    int VerifyQualifiedTypes()
    {
        MathTools.Counter counter = new MathTools.Counter(5);
        return MathTools.Counter.GetSeed() + counter.Value;
    }
}
