namespace MathTools.Nested
{
    using MathTools;

    interface IAdvancedEntity : MathTools.IEntity
    {
        int GetLevel();
    }

    class NestedGauge
    {
        int Value;

        NestedGauge(int value)
        {
            this.Value = value;
        }

        static int GetDefault()
        {
            return 9;
        }
    }
