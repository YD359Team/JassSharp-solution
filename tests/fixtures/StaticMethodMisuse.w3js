namespace StaticMethodMisuse
{
    public class Factory
    {
        public static int Create()
        {
            return 1;
        }

        public int Get()
        {
            return 2;
        }

        public int StoredValue;

        public static int ReadValue()
        {
            return StoredValue;
        }
    }

    public void OnInit()
    {
        Factory factory;
        int invalidStaticCall = factory.Create();
        int invalidInstanceCall = Factory.Get();
        int invalidStaticFieldAccess = Factory.ReadValue();
    }
}
