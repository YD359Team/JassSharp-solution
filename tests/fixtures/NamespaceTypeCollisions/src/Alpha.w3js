namespace Alpha
{
    class BaseEntity
    {
        public int BaseValue;

        BaseEntity()
        {
            BaseValue = 100;
        }
    }

    class Player : BaseEntity
    {
        static int GetStaticId()
        {
            return 10;
        }

        int GetId()
        {
            return BaseValue + 1;
        }
    }
}
