namespace Beta
{
    class BaseEntity
    {
        public int BaseValue;

        BaseEntity()
        {
            BaseValue = 200;
        }
    }

    class Player : BaseEntity
    {
        static int GetStaticId()
        {
            return 20;
        }

        int GetId()
        {
            return BaseValue + 2;
        }
    }
}
