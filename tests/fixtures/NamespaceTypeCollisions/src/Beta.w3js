namespace Beta
{
    interface IIdentity
    {
        int GetId();
    }

    class BaseEntity
    {
        public int BaseValue;

        BaseEntity()
        {
            BaseValue = 200;
        }
    }

    class Player : BaseEntity, IIdentity
    {
        static int GetStaticId()
        {
            return 20;
        }

        int GetId()
        {
            return BaseValue + 2;
        }
    }
}
