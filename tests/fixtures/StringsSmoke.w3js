namespace StringsSmoke
{
    public void Interpolation()
    {
        int x = 2;
        int y = 3;
        int z = 4;
        bool enabled = true;

        string basic = $"Product: {x * y * z}";
        string mixed = $"Result={x + y}; enabled={enabled}";
        string escapedBraces = $"{{literal}} and {{{x}}}";
        string multiline = """
            First line
            Second line
            Third line
            """;
        string multilineInterpolated = $"""
            Product: {x * y * z}
            Enabled: {enabled}
            Braces: {{literal}}
            """;
        string concatenated = $"Interpolated {x}" + " tail";
        string escapedSequences = "Line one\nLine two\tindented";
        string rawPath = """C:\temp\file""";

        Print(basic);
        Print(mixed);
        Print(escapedBraces);
        Print(multiline);
        Print(multilineInterpolated);
        Print(concatenated);
        Print(escapedSequences);
        Print(rawPath);
    }
}
